#!/usr/bin/env sh
# Pinned, checksum-verified cosign launcher: signs and verifies images and blobs (Apache-2.0).
# Trust model and cache layout: infrastructure/bin/lib/pinned.sh.
set -eu
. "$(dirname "$0")/lib/pinned.sh"
pinned_exec cosign "3.1.3" \
  "https://github.com/sigstore/cosign/releases/download/v3.1.3/cosign-linux-amd64" \
  "4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71" \
  "-" \
  "4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71" \
  -- "$@"
