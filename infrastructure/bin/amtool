  "19c75a11d8c03dc4ade7abdbddfb3a8f28c9e7b000d0849cda0cd71dffd74a03" \
  "alertmanager-0.34.0.linux-amd64/amtool" \
  "a42bdb03d527f4dc1045e105740944a2f7747838c988dc7a3138f1d4a5c626a0" \
  -- "$@"
