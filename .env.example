# FraudShield local development environment — variable names only, never real secrets.
# `make env` copies this file to .env and replaces every CHANGE_ME with a fresh random value.
# Development and demo stacks run on SYNTHETIC DATA ONLY (D-21).

# Primary PostgreSQL 16 + TimescaleDB (superuser used only for bootstrap and migrations)
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
# MLflow tracking-store database role
MLFLOW_DB_PASSWORD=CHANGE_ME
# FraudShield database roles (ADR 0017): migrations, service, read-only service, compliance
FS_MIGRATOR_DB_PASSWORD=CHANGE_ME
FS_APP_DB_PASSWORD=CHANGE_ME
FS_APP_READONLY_DB_PASSWORD=CHANGE_ME
FS_COMPLIANCE_RO_DB_PASSWORD=CHANGE_ME
# The scorer's feature-store fallback role (ADR 0062 point 6): executes the feature_fallback_*
# functions and nothing else
FS_SCORER_DB_PASSWORD=CHANGE_ME

# PII vault: separate PostgreSQL instance (D-20, ADR 0069)
PII_VAULT_SUPERUSER_PASSWORD=CHANGE_ME
# Vault roles: the migrator owns the vault schema; fs_vault is the notification service's role
FS_VAULT_MIGRATOR_DB_PASSWORD=CHANGE_ME
FS_VAULT_DB_PASSWORD=CHANGE_ME

# Redis 7.2 (feature store, idempotency, thresholds)
REDIS_PASSWORD=CHANGE_ME

# S3-compatible object store (SeaweedFS, ADR 0005) used as the MLflow artifact store
OBJECT_STORE_ACCESS_KEY=CHANGE_ME
OBJECT_STORE_SECRET_KEY=CHANGE_ME

# The API in Compose (profile full). Key material in the formats the API checks: HEX32 is 32 random
# bytes in hex, BASE64_32 is 32 random bytes in base64. The JWT signing key is a file, not a
# variable: `make env` writes it to .dev-secrets/api-jwt-signing-key.pem.
# HMAC key for staff unlock and reset tokens; AES-256 key for secrets at rest
FS_API_TOKEN_KEY_HEX=CHANGE_ME_HEX32
FS_API_SECRET_BOX_KEY_HEX=CHANGE_ME_HEX32
# API-key pepper, version 1; `make seed-demo` hashes the demo API key with this same pepper
FS_API_KEY_PEPPER_HEX=CHANGE_ME_HEX32
# PII vault master key and blind-index key (key provider "configured", dev profile only)
FS_VAULT_MASTER_KEY_B64=CHANGE_ME_BASE64_32
FS_VAULT_INDEX_KEY_B64=CHANGE_ME_BASE64_32
# Key for the SMS provider fake (WireMock); no real provider is reached from this stack
FS_SMS_API_KEY=CHANGE_ME
