<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.mariusbayizere.fraudshield</groupId>
    <artifactId>fraudshield-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>fraudshield-audit</artifactId>
  <name>FraudShield audit log</name>
  <description>Hash-chained audit writer, tenant transactions, daily signed anchors and the audit verification command (FR-06-06, D-32)</description>

  <dependencies>
    <dependency>
      <groupId>io.github.mariusbayizere.fraudshield</groupId>
      <artifactId>fraudshield-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- Without Docker the database tests are excluded (ADR 0010), so the line-coverage gate for this
         module is enforced only where they run. -->
    <profile>
      <id>without-docker-tests</id>
      <activation>
        <property>
          <name>excludedGroups</name>
          <value>requires-docker</value>
        </property>
      </activation>
      <properties>
        <coverage.line.minimum>0.00</coverage.line.minimum>
      </properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      <!-- The command-line entry point calls System.exit, so it cannot run inside the test JVM;
           AuditVerifyCommandTest covers its logic through run(). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/audit/cli/AuditCli.class</exclude>
          </excludes>
        </configuration>
      </plugin>
      <!-- `fraudshield audit verify`: a runnable jar beside the plain library jar, so other modules
           still depend on normal classes (classifier exec). -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <!-- Plugin-level, so the parent's default repackage execution uses it too. -->
        <configuration>
          <classifier>exec</classifier>
          <mainClass>io.github.mariusbayizere.fraudshield.audit.cli.AuditCli</mainClass>
        </configuration>
        <executions>
          <execution>
            <id>repackage</id>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- The test-support classes (TestDatabase) are shared with the auth and admin tests. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>test-jar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
