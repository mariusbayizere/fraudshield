<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.mariusbayizere.fraudshield</groupId>
    <artifactId>fraudshield-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>fraudshield-persistence</artifactId>
  <name>FraudShield database schema, security tests and demo seed</name>
  <description>Flyway migrations, database bootstrap, database security tests and the dev/demo data seeder (ADR 0017, ADR 0019)</description>

  <dependencies>
    <dependency>
      <groupId>io.github.mariusbayizere.fraudshield</groupId>
      <artifactId>fraudshield-deployment-guard</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- ADR 0068: the JPA entities mirror the schema this module owns. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <!-- The demo seed reads the country packs' FX rates. -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- Without Docker the database tests are excluded (ADR 0010), so the line-coverage gate for this
         module is enforced only where they run: CI and Codespaces. -->
    <profile>
      <id>without-docker-tests</id>
      <activation>
        <property>
          <name>excludedGroups</name>
          <value>requires-docker</value>
        </property>
      </activation>
      <properties>
        <coverage.line.minimum>0.00</coverage.line.minimum>
      </properties>
    </profile>
  </profiles>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The demo seed's FX rates are the country packs' fixed simulation rates, the same files
           the generator, the scorer and the analyst module read (ADR 0112); packaged, never
           copied. -->
      <resource>
        <directory>${maven.multiModuleProjectDirectory}/../dataset/generator/params/countries</directory>
        <targetPath>fraudshield/countries</targetPath>
        <includes>
          <include>*.yaml</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <!-- The command-line entry point calls System.exit, so it cannot run inside the test JVM. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/persistence/DatabaseToolApplication.class</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
