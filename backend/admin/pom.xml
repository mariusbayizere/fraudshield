<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.mariusbayizere.fraudshield</groupId>
    <artifactId>fraudshield-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>fraudshield-admin</artifactId>
  <name>FraudShield administration API</name>
  <description>Staff account lifecycle, approvals, office IP allowlist, API keys and audit search for administrators (FR-06-01, FR-06-02, FR-06-06, FR-06-07, D-23, D-24, D-26)</description>

  <dependencies>
    <dependency>
      <groupId>io.github.mariusbayizere.fraudshield</groupId>
      <artifactId>fraudshield-auth</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>io.github.mariusbayizere.fraudshield</groupId>
      <artifactId>fraudshield-auth</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.mariusbayizere.fraudshield</groupId>
      <artifactId>fraudshield-audit</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <configuration>
          <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml,${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>without-docker-tests</id>
      <activation>
        <property>
          <name>excludedGroups</name>
          <value>requires-docker</value>
        </property>
      </activation>
      <properties>
        <coverage.line.minimum>0.00</coverage.line.minimum>
      </properties>
    </profile>
  </profiles>
</project>
