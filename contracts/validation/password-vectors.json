{
  "description": "Password policy vectors (FR-07-07, ADR 0014): 8-72 code points and at most 72 UTF-8 bytes; no character of Unicode category Cc, Cf, Cs, Co or Z except U+0020 SPACE (unassigned code points are allowed); at least one ASCII upper-case letter, ASCII lower-case letter, ASCII digit, and one special character (any other permitted character except the space). Checks run in the order LENGTH, BYTES, CHARACTERS, UPPER, LOWER, DIGIT, SPECIAL and the first failure is the reason. schema_detectable says whether the JSON Schema screen alone rejects the input. Stored with JSON escapes so no hidden characters are committed.",
  "min_characters": 8,
  "max_characters": 72,
  "max_utf8_bytes": 72,
  "accept": [
    {
      "input": "Str0ng!pass",
      "note": "All four classes"
    },
    {
      "input": "short1!A",
      "note": "Minimum length 8"
    },
    {
      "input": "Aa1!aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "note": "72 ASCII characters = 72 bytes"
    },
    {
      "input": "Aa1!\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9",
      "note": "38 characters, 72 UTF-8 bytes (e-acute is 2 bytes)"
    },
    {
      "input": "Passw0rd\u00e9",
      "note": "A non-ASCII letter counts as the special character"
    },
    {
      "input": "Pass w0rd!",
      "note": "Spaces are allowed inside"
    },
    {
      "input": "Passw0rd\ud83d\ude00",
      "note": "An emoji counts as the special character (4 bytes)"
    },
    {
      "input": "Passw0rd\u20ac",
      "note": "A currency symbol counts as the special character"
    },
    {
      "input": "Passw0rd\u0378",
      "note": "An unassigned code point is allowed and counts as special (Unicode-version independent)"
