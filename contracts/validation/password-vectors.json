{
  "description": "Password policy vectors (FR-07-07, ADR 0014): 8-72 characters and at most 72 UTF-8 bytes; at least one ASCII upper-case letter, ASCII lower-case letter, ASCII digit and one character that is none of these and not whitespace. Checks run in the order LENGTH, BYTES, UPPER, LOWER, DIGIT, SPECIAL and the first failure is the reason. Stored with JSON escapes so no hidden characters are committed.",
  "min_characters": 8,
  "max_characters": 72,
  "max_utf8_bytes": 72,
  "accept": [
    {
      "input": "Str0ng!pass",
      "note": "All four classes"
    },
    {
      "input": "short1!A",
      "note": "Minimum length 8"
    },
    {
      "input": "Aa1!aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "note": "72 ASCII characters = 72 bytes"
    },
    {
      "input": "Aa1!\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9",
      "note": "38 characters, 72 UTF-8 bytes (e-acute is 2 bytes)"
    },
    {
      "input": "Passw0rd\u00e9",
      "note": "A non-ASCII letter counts as the special character"
    },
    {
      "input": "Pass w0rd!",
      "note": "Spaces are allowed inside"
    },
    {
      "input": "Passw0rd\ud83d\ude00",
      "note": "An emoji counts as the special character (4 bytes)"
    }
  ],
  "reject": [
    {
      "input": "Sh0rt!",
      "reason": "LENGTH",
      "note": "Below 8 characters"
    },
    {
      "input": "Aa1!aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "reason": "LENGTH",
      "note": "73 characters"
    },
    {
      "input": "Aa1!\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9\u00e9",
      "reason": "BYTES",
      "note": "39 characters but 74 UTF-8 bytes"
    },
    {
      "input": "Aa1!aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\ud83d\ude00",
      "reason": "BYTES",
      "note": "70 characters but 69 + 4 = 73 bytes"
    },
    {
      "input": "nouppercase1!",
      "reason": "UPPER",
      "note": "No ASCII upper-case letter"
    },
    {
      "input": "NOLOWERCASE1!",
      "reason": "LOWER",
      "note": "No ASCII lower-case letter"
    },
    {
      "input": "NoDigits!!",
      "reason": "DIGIT",
      "note": "No ASCII digit"
    },
    {
      "input": "NoSpecial123",
      "reason": "SPECIAL",
      "note": "No special character"
    },
    {
      "input": "NoSpecial 123",
      "reason": "SPECIAL",
      "note": "A space does not count as special"
    }
  ]
}
