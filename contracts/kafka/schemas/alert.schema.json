{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fraudshield:kafka:alert",
  "title": "fs.alerts.high / fs.alerts.medium / fs.alerts.anomaly payload",
  "type": "object",
  "required": [
    "alert_id",
    "version",
    "transaction_id",
    "account_token",
    "tier",
    "fraud_probability",
    "amount",
    "channel",
    "transaction_timestamp",
    "scoring_result_id",
    "review_deadline_at",
    "holds_transaction"
  ],
  "additionalProperties": false,
  "properties": {
    "alert_id": {
      "$ref": "urn:fraudshield:kafka:common#/$defs/Uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "transaction_id": {
      "$ref": "urn:fraudshield:kafka:common#/$defs/Uuid"
    },
    "account_token": {
      "$ref": "urn:fraudshield:kafka:common#/$defs/Token"
    },
    "tier": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "ANOMALY"
      ]
    },
    "fraud_probability": {
      "$ref": "urn:fraudshield:kafka:common#/$defs/Probability"
    },
    "anomaly_score": {
      "$ref": "urn:fraudshield:kafka:common#/$defs/Probability"
    },
    "amount": {
      "$ref": "urn:fraudshield:kafka:common#/$defs/Money"
    },
    "expected_loss_rwf": {
      "$ref": "urn:fraudshield:kafka:common#/$defs/DecimalAmount"
    },
    "channel": {
      "$ref": "urn:fraudshield:kafka:common#/$defs/Channel"
    },
    "merchant": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100,
      "description": "Optional (ADR 0115 point 6.1): absent on records written before it was added"
    },
    "transaction_timestamp": {
      "$ref": "urn:fraudshield:kafka:common#/$defs/Timestamp"
    },
    "scoring_result_id": {
      "$ref": "urn:fraudshield:kafka:common#/$defs/Uuid"
    },
    "review_deadline_at": {
      "oneOf": [
        {
          "$ref": "urn:fraudshield:kafka:common#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "holds_transaction": {
      "type": "boolean",
      "description": "False for ANOMALY alerts (D-10)"
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "urn:fraudshield:kafka:common#/$defs/ReasonCode"
      }
    },
    "top_reasons": {
      "type": "array",
      "maxItems": 3,
      "description": "Optional (ADR 0115 point 6.1): the scorer's top contributions as the OpenAPI ShapContribution, template_key included (the scorer sets it); absent on records written before it was added, empty when there are none",
      "items": {
        "type": "object",
        "required": [
          "feature",
          "value",
          "shap",
          "direction",
          "template_key"
        ],
        "additionalProperties": false,
        "properties": {
          "feature": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "shap": {
            "type": "number"
          },
          "direction": {
            "type": "string",
            "enum": [
              "INCREASES_RISK",
              "DECREASES_RISK"
            ]
          },
          "template_key": {
            "type": "string",
            "pattern": "^feature\\.[a-z0-9_]+\\.[a-z_]+$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tier": {
            "const": "MEDIUM"
          }
        },
        "required": [
          "tier"
        ]
      },
      "then": {
        "properties": {
          "review_deadline_at": {
            "$ref": "urn:fraudshield:kafka:common#/$defs/Timestamp"
          },
          "holds_transaction": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tier": {
            "const": "ANOMALY"
          }
        },
        "required": [
          "tier"
        ]
      },
      "then": {
        "properties": {
          "review_deadline_at": {
            "type": "null"
          },
          "holds_transaction": {
            "const": false
          }
        }
      }
    }
  ]
}
