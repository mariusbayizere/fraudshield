    "@mui/material": "9.4.0",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.38",
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.14",
    "stylis": "4.4.0",
    "stylis-plugin-rtl": "2.1.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.5"
  }
